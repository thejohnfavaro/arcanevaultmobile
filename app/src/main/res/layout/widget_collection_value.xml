<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_value_root"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="@drawable/widget_vault_background"
 android:orientation="vertical" android:padding="13dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_value_header"
   android:layout_width="0dp" android:layout_weight="1"
   android:layout_height="wrap_content"
   android:text="◆  ARCANE VAULT  /  COLLECTION VALUE" android:textSize="11sp"
   android:textColor="#E5BF79" android:textStyle="bold" android:maxLines="1"
   android:ellipsize="end"/>
  <TextView android:id="@+id/widget_value_configure"
   android:layout_width="40dp" android:layout_height="36dp"
   android:gravity="center" android:text="⚙"
   android:contentDescription="Configure collection value widget"
   android:textColor="#E5BF79" android:textSize="21sp"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_value_amount"
  android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:gravity="center_vertical"
  android:text="—" android:textSize="30sp" android:textColor="#F0F1F6"
  android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_value_change"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="Change pending · first tracked value"
  android:textColor="#9FADC3" android:textSize="13sp"
  android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_value_coverage"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="Open Arcane Vault to load estimates"
  android:textSize="12sp" android:textColor="#B59BFC" android:maxLines="1"
  android:ellipsize="end"/>
 <TextView android:id="@+id/widget_value_updated"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginTop="3dp" android:text="Scryfall USD · cached quotes"
  android:textSize="10sp" android:textColor="#9DA9BD" android:maxLines="1"
  android:ellipsize="end"/>
</LinearLayout>
